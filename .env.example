# COPY TO .env AND REPLACE EVERY SECRET before running Compose. Development only.
POSTGRES_PASSWORD=CHANGE_THIS_to_a_long_random_postgres_password_123
CAPSTONE_ROUTING_SECRET=CHANGE_THIS_to_an_independent_very_long_random_secret_456
CAPSTONE_TOKENS_JSON='{"alice-demo-development-key-aaaaaaaaaaaa":{"tenant":"acme","user":"alice","groups":["engineering"],"role":"editor"},"reviewer-demo-development-key-bbbbbbbbbbbb":{"tenant":"acme","user":"rachel","groups":["engineering"],"role":"reviewer"},"admin-demo-development-key-cccccccccccc":{"tenant":"acme","user":"sam","groups":["engineering"],"role":"admin"},"outsider-demo-development-key-dddddddddd":{"tenant":"other","user":"bob","groups":["engineering"],"role":"editor"}}'
CAPSTONE_RELEASE_TENANT=acme
MODEL_BACKEND=offline
# Set MODEL_BACKEND=openai, OPENAI_MODEL, and OPENAI_API_KEY only after reviewing privacy and billing.
# Host port for Docker Compose; change it if another app already uses 8000.
CAPSTONE_PORT=8000
# Host port for the React web UI in Docker Compose.
CAPSTONE_WEB_PORT=8090
# Run `python -m capstone.release_evidence keygen --out .secrets` and paste api_setting here.
CAPSTONE_ATTESTATION_KEYS='{}'
CAPSTONE_ARTIFACT_ROOT=./models
# Optional: approved semantic model (needs the `semantic` extra); default is the hash baseline.
# CAPSTONE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# PII redaction: regex (default) or presidio (needs the `privacy` extra; runs locally).
CAPSTONE_PII_DETECTOR=regex
